# Supabase (public URL + keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection (used by server-side DB helpers / migrations)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT signing secret (min 32 chars, used for server-issued session tokens)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# AI provider selection and keys
# AI_PROVIDER: one of grok | anthropic | openai | gemini (default: grok)
# HIPAA Safe Harbor de-identification is applied automatically in
# src/lib/ai-client.ts to every outgoing AI call. See src/lib/phi-sanitizer.ts
# for the redaction rules. This keeps plain Grok/Anthropic API usage compliant
# even without a signed BAA.
AI_PROVIDER=grok
XAI_API_KEY=
GROK_MODEL=grok-4-1-fast-non-reasoning
ANTHROPIC_API_KEY=
# Claude model used when AI_PROVIDER=anthropic (referenced by src/lib/ai-client.ts).
CLAUDE_MODEL=claude-sonnet-4-20250514

# PHI encryption key (min 32 chars, HIPAA-required)
ENCRYPTION_KEY=change-me-to-a-long-random-string-at-least-32-chars
# scrypt salt for PHI key derivation. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be set at module load; server will refuse to start without it.
# NEVER rotate this value without first re-encrypting every existing PHI
# ciphertext in the database — rotation will otherwise permanently break
# decryption of patient_profiles._enc columns, ai_conversations.messages_enc,
# and appointments.intake_data.
ENCRYPTION_KEY_SALT=change-me-to-32-random-bytes-hex

# Payment Provider (REQUIRED in production)
# Options: stub (dev only), stripe, authnet
# Set to a real provider name before deploying to production.
# Stub provider allows local testing but is disabled in NODE_ENV=production.
PAYMENT_PROVIDER=stub

# Stub provider only — token to allow non-auth confirm endpoint for testing.
# DO NOT set this in production. Only for local /checkout/stub-pay flow.
STUB_CONFIRM_TOKEN=

# Stripe payments (when PAYMENT_PROVIDER=stripe is implemented)
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# Authorize.net payments (when PAYMENT_PROVIDER=authnet)
# AUTHORIZENET_ENV=production
# AUTHORIZENET_API_LOGIN_ID=
# AUTHORIZENET_TRANSACTION_KEY=
# Optional, required only for webhook verification:
# AUTHORIZENET_SIGNATURE_KEY=

# USDA FoodData Central — nutrition auto-populate for the Food Log.
# Free API key: request one in seconds at https://fdc.nal.usda.gov/api-key-signup
# (or use the shared demo key "DEMO_KEY", which is heavily rate-limited).
# Powers /api/nutrition/search so typing a food name auto-fills calories/macros.
# If unset, the food log silently falls back to manual calorie entry (no crash).
USDA_FDC_API_KEY=

# App origin only. Do not append /staging — next.config basePath adds it.
# Production: https://checkout.juvenex.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Juvenex partner API (server-only — never prefix the key with NEXT_PUBLIC_)
JUVENEX_API_BASE_URL=https://panel.whitelabelmd.com/juvenex/api/v1
JUVENEX_API_KEY=

# ---------------------------------------------------------------------------
# Telehealth intake — HIPAA-compliant pass-through configuration
# ---------------------------------------------------------------------------
# TELEHEALTH_PROVIDER_URL: When set, telehealth intake POSTs forward the PHI
# payload to this external provider (which must hold the BAA) and only a
# provider_reference_id + status are persisted locally. This is the
# HIPAA-preferred configuration and should be enabled in production.
TELEHEALTH_PROVIDER_URL=
# Optional bearer token sent to the telehealth provider API.
TELEHEALTH_PROVIDER_API_KEY=
# Comma-separated list of hostnames the telehealth forwarder is permitted to
# POST to. Requests to hosts outside this allowlist are rejected to prevent
# SSRF against internal services.
TELEHEALTH_PROVIDER_ALLOWED_HOSTS=api.example-health.com,api.another-provider.com
# ALLOW_INTAKE_PERSISTENCE: Fallback-only escape hatch. When set to "true"
# AND TELEHEALTH_PROVIDER_URL is empty, intake PHI is encrypted and stored
# locally. Leave unset (or "false") in production covered-entity environments;
# with both off, POST /api/telehealth/appointments returns 503.
ALLOW_INTAKE_PERSISTENCE=false

# Telehealth provider type — values: 'two_step' (POST /patients then
# POST /encounters) | 'generic' (single POST to TELEHEALTH_PROVIDER_URL with
# the full intake payload). Legacy 'prescriberx' is accepted as alias for
# 'two_step'.
TELEHEALTH_PROVIDER_TYPE=generic

# Required when TELEHEALTH_PROVIDER_TYPE=two_step. UUID obtained from the
# upstream telehealth provider's dashboard (typically Settings → Encounter
# Types). Without it, /api/telehealth/appointments returns 503.
# Legacy alias PRESCRIBERX_ENCOUNTER_TYPE_ID is still read as a fallback;
# rename to the above.
TELEHEALTH_ENCOUNTER_TYPE_ID=

# ---------------------------------------------------------------------------
# Transactional email (Resend)
# ---------------------------------------------------------------------------
# Powers the jx store order-confirmation email sent by
# POST /api/juvenex/orders/confirm. Every send is best-effort: when
# RESEND_API_KEY is absent the email layer logs a warning and no-ops, so an
# unconfigured environment degrades to "no receipt" rather than a failed order.
RESEND_API_KEY=re_your_key_here

# Envelope sender. Must be a domain verified in the Resend dashboard or sends
# are rejected.
EMAIL_FROM=orders@juvenex.app

# Where customer replies land.
EMAIL_REPLY_TO=support@juvenex.app

# Stripe — tokenized checkout per WhiteLabelMD guidance
#
# The store charges through Stripe and hands the resulting PaymentIntent id to
# the vendor as `payment_token`; raw card data never reaches our servers.
# Both keys come from the same Stripe account — the publishable key is exposed
# to the browser (NEXT_PUBLIC_), the secret key must never be.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_get_from_braeden

# GHL / n8n questionnaire site id, also used by check_coupons_v3. Do not reuse KoverX/IdunRX ids.
JUVENEX_CHECKOUT_SITE_ID=453
# Fulfilment panel product catalog and the hidden /admin/pricing portal.
JUVENEX_PANEL_SITE_ID=614
CHECK_COUPONS_V3_URL=https://panel.whitelabelmd.com/wlmdbackend/api/check_coupons_v3
# Panel pricing APIs used by /admin/pricing (same endpoints as PrimeVida, site 614).
WLMD_PANEL_API_BASE=https://panel.whitelabelmd.com/wlmdbackend/api
WLMD_PANEL_AUTH_TOKEN=wlmd-order-key=REPLACE_ME
# Comma-separated emails that may open /admin/pricing after they sign in at /login.
# Defaults to the demo account when unset. The portal is not linked in the UI.
JUVENEX_PRICING_ADMIN_EMAILS=juvenex.demo.login@mailinator.com
# Top-layer Groupon/product check (Sema vs Tirz) before check_coupons_v3
GROUPON_CHECK_COUPON_URL=https://panel.whitelabelmd.com/nextvial/api/groupon/check-coupon

# Google Places Autocomplete for checkout address fields (browser-exposed key).
# Restrict the key to HTTP referrers + Places API in Google Cloud Console.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
STRIPE_SECRET_KEY=sk_test_placeholder_get_from_braeden

# Stage 2 intake — set to 'true' when WhiteLabelMD ships POST /v1/pending-forms
NEXT_PUBLIC_INTAKE_ENABLED=false

# ===========================================================================
# The variables below were read by the code but undocumented until Sep 2026.
# Each one is live — something breaks or silently no-ops without it.
# ===========================================================================

# ---------------------------------------------------------------------------
# Cron
# ---------------------------------------------------------------------------
# Shared secret for POST /api/cron/reconcile-subscriptions, sent by the caller
# as `Authorization: Bearer <secret>` or `x-cron-secret`. Without it the
# endpoint is DISABLED (503) rather than left open. The job is the authoritative
# backstop for recurring memberships — if it stops running, lapsed members keep
# access. Schedule: every 6h from root's crontab. See docs/OPERATIONS.md.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Membership billing — Kurv (via the payment-provider abstraction)
# ---------------------------------------------------------------------------
# PAYMENT_PROVIDER selects the implementation in src/lib/payments/:
#   kurv | stripe | authnet | stub   (unset = stub)
# The stub is HARD-DISABLED in production: isPaymentConfigured() returns false
# so checkout serves a graceful 503 instead of the app failing to boot.
# NOTE: this is the MEMBERSHIP path. The jx store checkout uses STRIPE_SECRET_KEY
# directly via src/lib/juvenex/stripe.ts and ignores PAYMENT_PROVIDER entirely.
KURV_API_KEY=
KURV_API_BASE=

# Stripe webhook signing secret. Required only for PAYMENT_PROVIDER=stripe —
# isPaymentConfigured() checks for it alongside STRIPE_SECRET_KEY. The store
# checkout does not use webhooks and does not need this.
STRIPE_WEBHOOK_SECRET=

# Authorize.net, used by src/lib/payments/authnet-provider.ts.
# AUTHORIZENET_ENV: sandbox | production
AUTHORIZENET_API_LOGIN_ID=
AUTHORIZENET_TRANSACTION_KEY=
AUTHORIZENET_SIGNATURE_KEY=
AUTHORIZENET_ENV=sandbox

# Comma-separated promo codes that comp a membership to $0 app-side, before any
# processor is called (e.g. JUVENEXTEST,JUVENEXFREE,TEAMCOMP). A comped order is
# ONE-TIME — it must not open a recurring subscription.
MEMBERSHIP_FREE_PROMO_CODES=

# ---------------------------------------------------------------------------
# Native in-app purchases — RevenueCat
# ---------------------------------------------------------------------------
# Bearer token on POST /api/payments/revenuecat/webhook. IAP subscriptions land
# in the same `subscriptions` table as web ones, with
# stripe_subscription_id = 'revenuecat:<app_user_id>'.
REVENUECAT_WEBHOOK_TOKEN=

# Comma-separated user ids allowed to send SANDBOX events. Leave empty in
# production — a sandbox purchase from an arbitrary account would otherwise
# grant real access.
REVENUECAT_SANDBOX_ALLOW_USER_IDS=

# ---------------------------------------------------------------------------
# Telehealth — PrescribeRx
# ---------------------------------------------------------------------------
# The hosted intake embeds on /consult and /telehealth, proxied first-party
# through /api/intake-proxy/*. PRESCRIBERX_ENCOUNTER_TYPE_ID matters more than
# it looks: the encounter type scopes which products an embed can reach.
PRESCRIBERX_API_BASE=
PRESCRIBERX_API_TOKEN=
PRESCRIBERX_WEBHOOK_SECRET=
PRESCRIBERX_ENCOUNTER_TYPE_ID=

# ---------------------------------------------------------------------------
# Affiliate tracking — Tapfiliate
# ---------------------------------------------------------------------------
# The account id is public (it goes in the browser tracking script); the API key
# is server-side, for conversion posting. Commission rate is configured in the
# Tapfiliate dashboard, not here. The tracker beacons to frstre.com, which must
# stay in the CSP (src/proxy.ts) or attribution is silently blocked.
NEXT_PUBLIC_TAPFILIATE_ACCOUNT_ID=
TAPFILIATE_API_KEY=

# ---------------------------------------------------------------------------
# Analytics and support
# ---------------------------------------------------------------------------
# Metricool site tracker hash (public). Its host is CSP-allow-listed.
NEXT_PUBLIC_METRICOOL_HASH=
# Support address shown in the UI.
NEXT_PUBLIC_SUPPORT_EMAIL=support@juvenex.app

# ---------------------------------------------------------------------------
# Tenancy
# ---------------------------------------------------------------------------
# Organization assigned to accounts that arrive without a tenant (registration,
# the social feed, the PrescribeRx webhook). Unset means those rows get a NULL
# organization_id, which the tenant guards treat as platform scope.
DEFAULT_ORGANIZATION_ID=

# ---------------------------------------------------------------------------
# Feature flags — all compared to the STRING 'true'
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_* values are INLINED AT BUILD TIME. Changing one requires a
# rebuild, not just a pm2 restart. Removing a line, rebuilding and restarting is
# the ~1-minute kill switch for a flagged feature.
NEXT_PUBLIC_TELEHEALTH_ENABLED=false
NEXT_PUBLIC_SOCIAL_FEED_ENABLED=false
NEXT_PUBLIC_PROGRESS_PICS_ENABLED=false
NEXT_PUBLIC_AI_MEAL_PLANS_ENABLED=false
NEXT_PUBLIC_CHATBOT_ENABLED=false
# 7-day free trial on paid memberships (card required, converts on day 7).
NEXT_PUBLIC_MEMBERSHIP_TRIAL_ENABLED=false

# ---------------------------------------------------------------------------
# Build-time only
# ---------------------------------------------------------------------------
# NEXT_DIST_DIR redirects the build output away from the live `.next` that the
# production process is serving. On the production box ALWAYS set it for any
# dev server or scratch build — see docs/OPERATIONS.md §2.
#   NEXT_DIST_DIR=.next-dev npx next dev
# NEXT_DIST_DIR=

# Set to '1' to disable the webpack build worker (next.config.ts). Only needed
# on a box where the worker runs out of memory during a build.
# NEXT_DISABLE_WEBPACK_BUILD_WORKER=

# Base URL the browser-side helpers in src/lib/api.ts prepend to admin calls.
# Defaults to '/api' (same origin), which is what you want. Set it only to point
# a client at a different backend host.
# NEXT_PUBLIC_API_URL=/api

# ===========================================================================
# READ BY src/lib/config.ts BUT WIRED TO NOTHING — do not set these.
#
#   AUTH_PROVIDER, NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY  (auth is Supabase)
#   SENDGRID_API_KEY                                  (email is Resend)
#   TWILIO_ACCOUNT_SID / _AUTH_TOKEN / _PHONE_NUMBER  (no SMS is sent)
#   DAILY_CO_API_KEY / _DOMAIN, TELEHEALTH_PROVIDER   (no video is hosted)
#   DB_PROVIDER, AI_MODEL, OPENAI_API_KEY / _MODEL
#
# They are read into the `config` object, but config.auth / .telehealth /
# .database / .ai / .payments are consumed by no call site. Only config.app and
# config.features are live. Setting these has no effect.
#
# Also unused, in the other direction: ALLOW_INTAKE_PERSISTENCE and
# TELEHEALTH_PROVIDER_TYPE appear above but nothing reads them.
# ===========================================================================
